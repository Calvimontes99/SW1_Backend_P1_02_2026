# Gemini (opcional: sin keys, la IA en la nube se desactiva y queda la IA local del navegador)
# Varias keys separadas por coma: se rotan al agotar la cuota gratuita (429), si una key es
# rechazada (403) o si su proyecto no puede usar el modelo. GEMINI_API_KEY también se suma. No commitear.
GEMINI_API_KEYS=
GEMINI_API_KEY=your_gemini_api_key_here
# DeepSeek: respaldo cuando Gemini se queda sin cuota o falla (solo texto, no imagen ni voz)
DEEPSEEK_API_KEY=
# Modelos en orden de preferencia (opcional)
# GEMINI_MODELS=gemini-2.5-flash,gemini-flash-lite-latest

# Base de datos: DATABASE_URL (lo habitual en la nube) o las variables DB_*.
# Sin DATABASE_URL, DB_PASSWORD es OBLIGATORIA. Si la base está vacía, las tablas se crean solas.
# DATABASE_URL=postgres://usuario:clave@host:5432/base
DB_USER=postgres
DB_HOST=localhost
DB_NAME=diagrama_dev
DB_PASSWORD=
DB_PORT=5432
# true si la base exige TLS (bases administradas accedidas desde fuera de su red)
# DB_SSL=true

# JWT (OBLIGATORIA - el servidor no arranca sin ella). En producción usar una nueva y larga:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_SECRET=

# Cuentas de prueba: al arrancar se crean prueba1@gmail.com y prueba2@gmail.com con esta
# contraseña (12345678 si no se define; se actualiza si ya existen). Vacía = no se crean.
# CLAVE_USUARIOS_PRUEBA=
# Server Configuration (en la nube PORT lo asigna la plataforma)
PORT=8083
NODE_ENV=development

# Orígenes permitidos por CORS, separados por coma. En producción no hace falta cuando el
# backend sirve el frontend (misma URL); solo si el frontend está en otro dominio.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Carpeta temporal para proyectos exportados (opcional; por defecto usa el tmp del sistema)
# EXPORT_TMP_DIR=
# Carpeta del frontend compilado (opcional; por defecto ../frontend/dist). Puede ser relativa
# a la carpeta desde donde se arranca el backend; en Render es .frontend/dist (ver render.yaml)
# FRONTEND_DIST=
